POSTGRES_PASSWORD=
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/postgres?sslmode=disable
WATCHTOWER_TOKEN=
# COMPOSE_PROFILES=server
# Host ports, bound to 127.0.0.1 only. Change them when 5432/8080/8081 are taken on the host.
POSTGRES_PORT=5432
API_PORT=8080
WATCHTOWER_PORT=8081
